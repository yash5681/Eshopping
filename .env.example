# Django Secret Key (Generate a random string in production)
SECRET_KEY=your-secret-key-here

# Debug Mode: False for production, True for local development
DEBUG=False

# Allowed Hosts (comma-separated, e.g. .onrender.com,localhost,127.0.0.1)
ALLOWED_HOSTS=*

# CSRF Trusted Origins (comma-separated, required for Render forms)
CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# Database URL (Render PostgreSQL sets this automatically)
# DATABASE_URL=postgresql://username:password@hostname:5432/databasename

# Initial Admin Superuser (Optional: will be created automatically on deploy if set)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
ADMIN_EMAIL=admin@example.com
